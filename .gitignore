# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Test artifacts
test-disks/*.img
test-disks/[0-9]*/
test-disks/test-run/
!test-disks/.gitkeep

# VM harness scratch (per-VM Vagrant state, cached boot assets).
# Produced by scripts/vm.sh. Re-runnable, never in source control.
.qemu/
**/.vagrant/
test-disks/.vm-cache/
.claude/

# Build output. `chore staticlib` writes the archive here for a consumer to
# copy out of (`chore artifact` prints this directory).
/dist/

# chore fingerprint cache (sources:/generates: checksums). Derived data.
.chore/
